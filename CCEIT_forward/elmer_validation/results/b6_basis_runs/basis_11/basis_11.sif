Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 2D"
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Angular Frequency = 3141592.653589793
  Post File = "basis_11.vtu"
End

Constants
  Permittivity of Vacuum = 8.8541878128e-12
End

Equation 1
  Name = "Harmonic current conduction"
  Active Solvers(1) = 1
End

Solver 1
  Exec Solver = Always
  Equation = "Harmonic current conduction"
  Procedure = "StatCurrentSolve" "StatCurrentSolver"
  Variable = Potential
  Variable DOFs = 1
  Harmonic Mode = Logical True
  Calculate Volume Current = Logical True
  Calculate Joule Heating = Logical False
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
End

Material 1
  Name = "Water phantom medium"
  Electric Conductivity = Real 0.025
  Relative Permittivity = Real 80
End

Material 2
  Name = "Explicit dielectric ring"
  Electric Conductivity = Real 1e-12
  Relative Permittivity = Real 3
End

Body 1
  Name = "Medium"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Body 2
  Name = "Dielectric ring"
  Target Bodies(1) = 2
  Equation = 1
  Material = 2
End

Boundary Condition 1
  Name = "Electrode 1 - basis 11"
  Target Boundaries(1) = 11
  Potential 1 = Real 0
  Potential 2 = Real 0
End

